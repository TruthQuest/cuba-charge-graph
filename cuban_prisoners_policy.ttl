# =============================================================================
# CUBAN POLITICAL PRISONERS ONTOLOGY: ETHICS AND POLICY OVERLAY v1.0
# Encodes lawful basis, purpose, access tiers, use policy, and per-subject risk.
# =============================================================================

@prefix :         <http://prisoners.defenders.org/ontology#> .
@prefix policy:   <http://prisoners.defenders.org/policy#> .
@prefix rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms:  <http://purl.org/dc/terms/> .
@prefix dcat:     <http://www.w3.org/ns/dcat#> .
@prefix foaf:     <http://xmlns.com/foaf/0.1/> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix prov:     <http://www.w3.org/ns/prov#> .
@prefix odrl:     <http://www.w3.org/ns/odrl/2/> .
@prefix dpv:      <https://w3id.org/dpv#> .
@prefix dpv-pd:   <https://w3id.org/dpv/dpv-pd#> .
@prefix cc:       <http://creativecommons.org/ns#> .

# =============================================================================
# DATASET METADATA
# =============================================================================

policy:CubanPoliticalPrisonersDataset a dcat:Dataset , dpv:PersonalDataHandling ;
    dcterms:title "Cuban Political Prisoners Dataset"@en ;
    dcterms:publisher <http://prisoners.defenders.org/agent/project> ;
    dcterms:source <https://lista.prisonersdefenders.org/> ;
    dcterms:issued "2026-05-16"^^xsd:date ;
    dcterms:modified "2026-08-22"^^xsd:date ;
    dcterms:accessRights policy:TieredAccess ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    cc:attributionName "Prisoners Defenders + Cuban Political Prisoners Ontology Project" ;
    cc:attributionURL <https://www.prisonersdefenders.org/> .

# =============================================================================
# DPV: LEGAL BASIS, PURPOSE, SPECIAL-CATEGORY DATA
# =============================================================================

policy:DataProcessing a dpv:PersonalDataHandling ;
    dpv:hasDataSubject dpv:DataSubject ;
    dpv:hasPersonalData dpv-pd:Name , dpv-pd:Age , dpv-pd:CriminalConviction ,
                        dpv-pd:PoliticalOpinion , dpv-pd:Location ;
    dpv:hasPurpose policy:PublicInterestHumanRights ;
    dpv:hasLegalBasis policy:LegitimateInterestPublicInterest ;
    dpv:hasProcessing dpv:Collect , dpv:Store , dpv:Analyse , dpv:Disclose , dpv:MakeAvailable ;
    dpv:hasRisk policy:RetaliationRisk , policy:FamilyEndangermentRisk .

policy:PublicInterestHumanRights a dpv:Purpose ;
    rdfs:label "Public Interest: Human Rights Documentation and Accountability"@en ;
    rdfs:comment "Documenting political detention for accountability journalism, UN treaty-body reporting, and litigation support."@en .

policy:LegitimateInterestPublicInterest a dpv:LegalBasis ;
    rdfs:label "Legitimate interest overriding privacy for grave human rights violations"@en ;
    rdfs:comment "Data subjects are already named publicly by Prisoners Defenders with consent frameworks; secondary processing serves the same accountability purpose."@en .

# Category flag: political opinion is Art. 9 GDPR special-category data.
# The dataset is therefore high-sensitivity by default.
policy:SpecialCategoryFlag a dpv:SpecialCategoryPersonalData ;
    rdfs:comment "Entire dataset qualifies as special-category personal data per GDPR Art. 9 and analogous frameworks."@en .

# =============================================================================
# ACCESS TIERS
# =============================================================================

policy:TieredAccess a skos:ConceptScheme ;
    skos:hasTopConcept policy:PublicTier , policy:ResearchTier , policy:RestrictedTier .

policy:PublicTier a skos:Concept ;
    skos:prefLabel "Public"@en ;
    skos:definition "Aggregate statistics, T-Box, SHACL shapes, and SKOS vocabularies. No individual A-Box records."@en ;
    skos:inScheme policy:TieredAccess .

policy:ResearchTier a skos:Concept ;
    skos:prefLabel "Research Access"@en ;
    skos:definition "Full A-Box under signed data-use agreement prohibiting re-identification enrichment and requiring incident-report obligations."@en ;
    skos:inScheme policy:TieredAccess .

policy:RestrictedTier a skos:Concept ;
    skos:prefLabel "Restricted"@en ;
    skos:definition "Records flagged HighRisk or CurrentlyDetained-in-Cuba are withheld from Research tier by default and require case-by-case release."@en ;
    skos:inScheme policy:TieredAccess .

# =============================================================================
# ODRL POLICY: MACHINE-READABLE USE TERMS
# =============================================================================

policy:UsePolicy a odrl:Policy , odrl:Set ;
    dcterms:description "Machine-readable use policy for the Cuban Political Prisoners Dataset."@en ;

    odrl:permission [
        odrl:action odrl:reproduce , odrl:derive , odrl:distribute ;
        odrl:target policy:CubanPoliticalPrisonersDataset ;
        odrl:duty [
            odrl:action cc:Attribution ;
            odrl:target policy:CubanPoliticalPrisonersDataset
        ]
    ] ;

    odrl:prohibition [
        odrl:action odrl:aggregate ;
        odrl:target policy:CubanPoliticalPrisonersDataset ;
        rdfs:comment "Prohibits combining with other datasets to derive additional PII about listed individuals (e.g., family members, home addresses, employers)."@en
    ] ;

    odrl:prohibition [
        odrl:action odrl:sell , odrl:commercialize ;
        odrl:target policy:CubanPoliticalPrisonersDataset
    ] ;

    odrl:prohibition [
        odrl:action policy:trainModel ;
        odrl:target policy:CubanPoliticalPrisonersDataset ;
        rdfs:comment "Prohibits use as training data for generative or classification models targeting individuals."@en
    ] .

policy:trainModel a odrl:Action ;
    rdfs:label "Train ML Model"@en .

# =============================================================================
# PER-SUBJECT RISK ANNOTATIONS
# Attach these to individual :Person instances in the A-Box.
# =============================================================================

policy:RiskLevel a owl:Class ;
    rdfs:label "Risk Level"@en ;
    rdfs:comment "A safety-relevant classification of a data subject's exposure."@en .

policy:HighRisk        a policy:RiskLevel ; skos:prefLabel "High Risk"@en ;
    rdfs:comment "Currently detained in Cuba, or family members in Cuba subject to state pressure."@en .
policy:MediumRisk      a policy:RiskLevel ; skos:prefLabel "Medium Risk"@en ;
    rdfs:comment "Released but remaining in Cuba, subject to continued state surveillance."@en .
policy:LowRisk         a policy:RiskLevel ; skos:prefLabel "Low Risk"@en ;
    rdfs:comment "Departed Cuba; already public figure; deceased."@en .

policy:hasRiskLevel a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :Person ;
    rdfs:range policy:RiskLevel ;
    rdfs:label "has risk level"@en .

policy:RetaliationRisk a dpv:Risk ;
    rdfs:label "Risk of state retaliation against data subject"@en .

policy:FamilyEndangermentRisk a dpv:Risk ;
    rdfs:label "Risk to data subject's family remaining in Cuba"@en .

# =============================================================================
# PROV: EDITORIAL AND VERIFICATION CHAIN
# =============================================================================

policy:VerificationActivity a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "Manual Verification Activity"@en ;
    rdfs:comment "A human verification pass against the primary source."@en .

policy:verifiedBy a owl:ObjectProperty ;
    rdfs:domain :Person ;
    rdfs:range prov:Agent ;
    rdfs:label "verified by"@en .

policy:verificationDate a owl:DatatypeProperty ;
    rdfs:domain :Person ;
    rdfs:range xsd:date .
