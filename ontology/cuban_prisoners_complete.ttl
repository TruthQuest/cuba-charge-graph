# ============================================================================
# MAJOR DETENTION FACILITIES (Proper SKOS with editorial separation)
# ============================================================================

pd:VillaMarista a :TortureFacility ;
    :officialDesignation "Dirección General de Contrainteligencia" ;
    skos:prefLabel "Villa Marista"@es , "Villa Marista"@en ;
    skos:altLabel "DGCI"@es ;
    skos:altLabel "Contrainteligencia"@es ;
    skos:altLabel "State Security Headquarters"@en ;
    skos:scopeNote "State Security interrogation and detention facility documented as site of torture by Amnesty International (2009), Human Rights Watch (2009), and UN Special Rapporteur on Torture (2014)"@en ;
    skos:scopeNote "Centro de interrogación y detención de la Seguridad del Estado documentado como sitio de tortura por Amnistía Internacional (2009), Human Rights Watch (2009) y Relator Especial de la ONU sobre Tortura (2014)"@es ;
    skos:historyNote "Former Catholic school (Colegio de los Hermanos Maristas) converted to State Security headquarters after 1959 revolution. Located in Marianao municipality, Havana"@en ;
    skos:historyNote "Antigua escuela católica (Colegio de los Hermanos Maristas) convertida en sede de Seguridad del Estado después de la revolución de 1959. Ubicada en el municipio de Marianao, La Habana"@es ;
    skos:editorialNote "Classified as TortureFacility based on documented interrogation practices including prolonged isolation (90+ days), sleep deprivation, threats against family members, physical abuse, and denial of legal counsel, meeting UN CAT Article 1 definition of torture"@en ;
    :locatedInProvince pd:LaHabana ;
    :locatedInMunicipality pd:Marianao ;
    geo:lat "23.1184"^^xsd:decimal ;
    geo:long "-82.3775"^^xsd:decimal ;
    :administeredBy [
        a foaf:Organization ;
        foaf:name "Dirección General de Contrainteligencia" ;
        skos:prefLabel "DGCI"@es ;
        rdfs:label "General Directorate of Counterintelligence"@en
    ] ;
    dcterms:source <https://www.hrw.org/report/2009/11/18/new-castro-new-cuba/political-prisoners-post-fidel-era> ,
                   <https://www.amnesty.org/en/documents/amr25/015/2009/en/> ,
                   <https://lista.prisonersdefenders.org/> .

pd:CombinadoDelEste a :Prison , :ForcedLaborCamp ;
    :officialDesignation "Establecimiento Penitenciario Combinado del Este" ;
    skos:prefLabel "Combinado del Este"@es , "Combinado del Este"@en ;
    skos:altLabel "Combinado"@es ;
    skos:altLabel "El Este"@es ;
    skos:scopeNote "Largest prison complex in Cuba, estimated capacity 3,000-5,000 inmates. Houses both common criminals and political prisoners in separate wings"@en ;
    skos:scopeNote "Complejo penitenciario más grande de Cuba, capacidad estimada de 3,000-5,000 reclusos. Alberga tanto delincuentes comunes como presos políticos en alas separadas"@es ;
    skos:historyNote "Constructed 1964, expanded multiple times. Originally designed for 2,000 inmates but chronically overcrowded"@en ;
    skos:editorialNote "Classified as ForcedLaborCamp due to mandatory agricultural and industrial labor programs documented by former inmates and human rights organizations. Labor is compulsory regardless of sentence type"@en ;
    :locatedInProvince pd:LaHabana ;
    geo:lat "23.0819"^^xsd:decimal ;
    geo:long "-82.3186"^^xsd:decimal .

pd:Kilo7 a :Prison ;
    :officialDesignation "Prisión Kilo 7" ;
    skos:prefLabel "Kilo 7"@es , "Kilo 7"@en ;
    skos:altLabel "Prisión Kilo Siete"@es ;
    skos:altLabel "Kilo Seven Prison"@en ;
    skos:scopeNote "Provincial prison in Camagüey housing political prisoners alongside common criminals. Named for its location 7 kilometers from city center"@en ;
    :locatedInProvince pd:Camaguey ;
    geo:lat "21.3833"^^xsd:decimal ;
    geo:long "-77.9167"^^xsd:decimal .

pd:CombinadoDelSur a :Prison ;
    :officialDesignation "Prisión Combinado del Sur" ;
    skos:prefLabel "Combinado del Sur"@es , "Combinado del Sur"@en ;
    skos:scopeNote "Provincial prison complex in Matanzas province"@en ;
    :locatedInProvince pd:Matanzas ;
    geo:lat "22.5500"^^xsd:decimal ;
    geo:long "-81.6000"^^xsd:decimal .

pd:LasMangasNuevas a :Prison ;
