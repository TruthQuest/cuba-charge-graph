pd:July2021Wave a :ArrestWave ;
    skos:prefLabel "July 2021 Arrest Wave"@en , "Ola de Arrestos de Julio 2021"@es ;
    skos:definition "Mass arrests following the July 11, 2021 anti-government protests across Cuba"@en ;
    skos:definition "Arrestos masivos después de las protestas antigubernamentales del 11 de julio de 2021 en Cuba"@es ;
    skos:scopeNote "Largest wave of political detentions since the 1959 revolution. 615 documented arrests between July 11 and August 31, 2021 representing 48.9% of total dataset"@en ;
    skos:historyNote "Protests began July 11, 2021 in San Antonio de los Baños, Artemisa province, spreading to over 40 cities within 24 hours. State response included internet shutdown, deployment of special forces, and mass arrests"@en ;
    dcterms:temporal [
        a dcterms:PeriodOfTime ;
        dcterms:start "2021-07-11"^^xsd:date ;
        dcterms:end "2021-08-31"^^xsd:date
    ] .

