@prefix : <http://prisoners.defenders.org/ontology#> .
@prefix pd: <http://prisoners.defenders.org/data#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix bfo: <http://purl.obolibrary.org/obo/> .
@prefix geo: <http://www.w3.org/2003/01/geo/wgs84_pos#> .

# ============================================================================
# ONTOLOGY METADATA
# ============================================================================

<http://prisoners.defenders.org/ontology> a owl:Ontology ;
    dcterms:title "Cuban Political Prisoners Ontology"@en , "Ontología de Presos Políticos Cubanos"@es ;
    dcterms:description "A formal ontology modeling political detention, forced labor, and judicial persecution in Cuba with full SKOS vocabulary separating official terminology from analytical assessment"@en ;
    dcterms:creator "Designed for accountability journalism and human rights documentation" ;
    dcterms:created "2026-05-16"^^xsd:date ;
    dcterms:modified "2026-05-16"^^xsd:date ;
    dcterms:source <https://lista.prisonersdefenders.org/> ;
    owl:versionIRI <http://prisoners.defenders.org/ontology/2.0-skos> ;
    owl:versionInfo "2.0-SKOS - Complete SKOS vocabulary with proper editorial separation" ;
    rdfs:comment "Production ontology maintaining intellectual honesty through SKOS separation of official designations, common usage, documented facts, and analytical classifications"@en ;
    owl:imports <http://purl.obolibrary.org/obo/bfo.owl> .

# ============================================================================
# CLASS HIERARCHY (BFO-aligned)
# ============================================================================

:Person a owl:Class ;
    rdfs:subClassOf bfo:BFO_0000023 ;
    rdfs:label "Person"@en , "Persona"@es ;
    skos:definition "An individual human being subject to state detention or judicial proceedings"@en ;
    skos:definition "Un individuo humano sujeto a detención estatal o procesos judiciales"@es .

:PoliticalPrisoner a owl:Class ;
    rdfs:subClassOf :Person ;
    rdfs:label "Political Prisoner"@en , "Preso Político"@es ;
    skos:definition "A person detained, prosecuted, or imprisoned for political activities, expression, or dissent against the state"@en ;
    skos:definition "Una persona detenida, procesada o encarcelada por actividades políticas, expresión o disidencia contra el estado"@es .

:Arrest a owl:Class ;
    rdfs:subClassOf bfo:BFO_0000015 ;
    rdfs:label "Arrest"@en , "Arresto"@es ;
    skos:definition "A process in which a person is taken into state custody by force or legal authority"@en ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty :arrestDate ;
        owl:cardinality 1
    ] .

:Charge a owl:Class ;
    rdfs:subClassOf bfo:BFO_0000031 ;
    rdfs:label "Charge"@en , "Cargo"@es ;
    skos:definition "A specific instance of a formal criminal accusation filed by the state against an individual"@en .

:ChargeType a owl:Class ;
    rdfs:label "Charge Type"@en , "Tipo de Cargo"@es ;
    skos:definition "A classification of criminal charges under Cuban law"@en .

:Sentence a owl:Class ;
    rdfs:subClassOf bfo:BFO_0000031 ;
    rdfs:label "Sentence"@en , "Sentencia"@es ;
    skos:definition "A judicial determination of punishment type and duration"@en ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty :sentenceLengthYears ;
        owl:maxCardinality 1
    ] .

:DetentionFacility a owl:Class ;
    rdfs:subClassOf bfo:BFO_0000040 ;
    rdfs:label "Detention Facility"@en , "Centro de Detención"@es ;
    skos:definition "A physical location where prisoners are held by the state"@en .

:PenalStatus a owl:Class ;
    rdfs:subClassOf bfo:BFO_0000023 ;
    rdfs:label "Penal Status"@en , "Estado Penal"@es ;
    skos:definition "The legal and custodial condition of a prisoner under state authority"@en .

:Province a owl:Class ;
    rdfs:subClassOf bfo:BFO_0000029 ;
    rdfs:label "Province"@en , "Provincia"@es ;
    skos:definition "A first-level administrative division of Cuba"@en .

:Municipality a owl:Class ;
    rdfs:subClassOf bfo:BFO_0000029 ;
    rdfs:label "Municipality"@en , "Municipio"@es ;
    skos:definition "A second-level administrative division of Cuba"@en .

:ArrestWave a owl:Class ;
    rdfs:subClassOf bfo:BFO_0000015 ;
    rdfs:label "Arrest Wave"@en , "Ola de Arrestos"@es ;
    skos:definition "A coordinated pattern of mass arrests in temporal proximity"@en .

:Prison a owl:Class ;
    rdfs:subClassOf :DetentionFacility ;
    rdfs:label "Prison"@en , "Prisión"@es ;
    skos:definition "A permanent state facility designed for long-term incarceration"@en .

:ForcedLaborCamp a owl:Class ;
    rdfs:subClassOf :DetentionFacility ;
    rdfs:label "Forced Labor Camp"@en , "Campo de Trabajo Forzoso"@es ;
    skos:definition "A facility where prisoners are compelled to perform labor against their will"@en ;
    skos:scopeNote "Violates ILO Convention 29 on Forced Labour"@en .

:TortureFacility a owl:Class ;
    rdfs:subClassOf :DetentionFacility ;
    rdfs:label "Torture Facility"@en , "Centro de Tortura"@es ;
    skos:definition "A facility where interrogation occurs under conditions meeting UN CAT Article 1 definition"@en ;
    skos:editorialNote "Classification based on documented practices including prolonged isolation, sleep deprivation, threats against family, physical abuse reported by former detainees and human rights organizations"@en .

:PretrialDetentionCenter a owl:Class ;
    rdfs:subClassOf :DetentionFacility ;
    rdfs:label "Pretrial Detention Center"@en , "Centro de Detención Preventiva"@es .

:Imprisoned a owl:Class ;
    rdfs:subClassOf :PenalStatus ;
    rdfs:label "Imprisoned"@en , "Encarcelado"@es .

:ProvisionalDetention a owl:Class ;
    rdfs:subClassOf :PenalStatus ;
    rdfs:label "Provisional Detention"@en , "Detención Provisional"@es ;
    skos:scopeNote "Extended provisional detention violates ICCPR Article 9"@en .

:ConditionalRelease a owl:Class ;
    rdfs:subClassOf :PenalStatus ;
    rdfs:label "Conditional Release"@en , "Libertad Condicional"@es .

:HouseArrest a owl:Class ;
    rdfs:subClassOf :PenalStatus ;
    rdfs:label "House Arrest"@en , "Arresto Domiciliario"@es .

:ForcedLaborWithoutInternment a owl:Class ;
    rdfs:subClassOf :PenalStatus ;
    rdfs:label "Forced Labor Without Internment"@en , "Trabajo Forzoso sin Internamiento"@es .

:UnderThreats a owl:Class ;
    rdfs:subClassOf :PenalStatus ;
    rdfs:label "Under Threats"@en , "Bajo Amenazas"@es ;
    skos:definition "Subject to explicit or implicit threats of harm, detention, or persecution"@en ;
    skos:scopeNote "Indicates extralegal coercion mechanism"@en .

# ============================================================================
# DISJOINT CLASS AXIOMS
# ============================================================================

[] a owl:AllDisjointClasses ;
    owl:members ( :Person :DetentionFacility :Arrest :Charge :Sentence :Province ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :Province :Municipality ) .

# ============================================================================
# OBJECT PROPERTIES
# ============================================================================

:arrested a owl:ObjectProperty ;
    rdfs:domain :Person ;
    rdfs:range :Arrest ;
    rdfs:label "arrested"@en , "arrestado"@es .

:chargedWith a owl:ObjectProperty ;
    rdfs:domain :Person ;
    rdfs:range :Charge ;
    rdfs:label "charged with"@en , "acusado de"@es .

:sentenced a owl:ObjectProperty ;
    rdfs:domain :Person ;
    rdfs:range :Sentence ;
    rdfs:label "sentenced"@en , "sentenciado"@es .

:detainedAt a owl:ObjectProperty ;
    rdfs:domain :Person ;
    rdfs:range :DetentionFacility ;
    rdfs:label "detained at"@en , "detenido en"@es .

:hasPenalStatus a owl:ObjectProperty ;
    rdfs:domain :Person ;
    rdfs:range :PenalStatus ;
    rdfs:label "has penal status"@en , "tiene estado penal"@es .

:residesInProvince a owl:ObjectProperty ;
    rdfs:domain :Person ;
    rdfs:range :Province ;
    rdfs:label "resides in province"@en .

:hasChargeType a owl:ObjectProperty ;
    rdfs:domain :Charge ;
    rdfs:range :ChargeType ;
    rdfs:label "has charge type"@en .

:filedAgainst a owl:ObjectProperty ;
    rdfs:domain :Charge ;
    rdfs:range :Person ;
    rdfs:label "filed against"@en ;
    owl:inverseOf :chargedWith .

:arrestOf a owl:ObjectProperty ;
    rdfs:domain :Arrest ;
    rdfs:range :Person ;
    rdfs:label "arrest of"@en ;
    owl:inverseOf :arrested .

:occurredInProvince a owl:ObjectProperty ;
    rdfs:domain :Arrest ;
    rdfs:range :Province ;
    rdfs:label "occurred in province"@en .

:partOfWave a owl:ObjectProperty ;
    rdfs:domain :Arrest ;
    rdfs:range :ArrestWave ;
    rdfs:label "part of wave"@en .

:detains a owl:ObjectProperty ;
    rdfs:domain :DetentionFacility ;
    rdfs:range :Person ;
    rdfs:label "detains"@en ;
    owl:inverseOf :detainedAt .

:locatedInProvince a owl:ObjectProperty ;
    rdfs:domain :DetentionFacility ;
    rdfs:range :Province ;
    rdfs:label "located in province"@en .

:locatedInMunicipality a owl:ObjectProperty ;
    rdfs:domain :DetentionFacility ;
    rdfs:range :Municipality ;
    rdfs:label "located in municipality"@en .

:administeredBy a owl:ObjectProperty ;
    rdfs:domain :DetentionFacility ;
    rdfs:range foaf:Organization ;
    rdfs:label "administered by"@en .

:containsMunicipality a owl:ObjectProperty ;
    rdfs:domain :Province ;
    rdfs:range :Municipality ;
    rdfs:label "contains municipality"@en .

# ============================================================================
# DATATYPE PROPERTIES
# ============================================================================

:fullName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Person ;
    rdfs:range xsd:string ;
    rdfs:label "full name"@en .

:currentAge a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Person ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:label "current age"@en .

:ageAtArrest a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Person ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:label "age at arrest"@en .

:arrestDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Arrest ;
    rdfs:range xsd:date ;
    rdfs:label "arrest date"@en .

:sentenceLengthYears a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Sentence ;
    rdfs:range xsd:decimal ;
    rdfs:label "sentence length in years"@en .

:facilityName a owl:DatatypeProperty ;
    rdfs:domain :DetentionFacility ;
    rdfs:range xsd:string ;
    rdfs:label "facility name"@en ;
    rdfs:comment "Common name for the facility, not necessarily official designation"@en .

:officialDesignation a owl:DatatypeProperty ;
    rdfs:domain :DetentionFacility ;
    rdfs:range xsd:string ;
    rdfs:label "official designation"@en ;
    rdfs:comment "Official name as designated by Cuban authorities"@en .

:provinceName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Province ;
    rdfs:range xsd:string ;
    rdfs:label "province name"@en .

:municipalityName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Municipality ;
    rdfs:range xsd:string ;
    rdfs:label "municipality name"@en .

:sourceURL a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf ( :Person :Arrest :Charge :Sentence ) ] ;
    rdfs:range xsd:anyURI ;
    rdfs:label "source URL"@en .

:scrapedAt a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf ( :Person :Arrest :Charge :Sentence ) ] ;
    rdfs:range xsd:dateTime ;
    rdfs:label "scraped at"@en .
# ============================================================================
# SKOS CONCEPT SCHEME FOR CHARGE TYPES
# ============================================================================

:CubanPenalCode a skos:ConceptScheme ;
    rdfs:label "Cuban Penal Code Charges"@en , "Cargos del Código Penal Cubano"@es ;
    dcterms:description "Controlled vocabulary of criminal charges under Cuban law as applied to political prisoners"@en ;
    dcterms:source <https://www.gacetaoficial.gob.cu/> ;
    skos:hasTopConcept :PoliticalCrime , :CommonCrime .

:PoliticalCrime a skos:Concept ;
    skos:prefLabel "Political Crime"@en , "Delito Político"@es ;
    skos:definition "Criminal charges explicitly targeting political activities, expression, or state security"@en ;
    skos:definition "Cargos criminales que explícitamente atacan actividades políticas, expresión o seguridad del estado"@es ;
    skos:inScheme :CubanPenalCode ;
    skos:narrower :SedicionType , :PropagandaContraOrdenType , :PropagandaEnemigaType , :SabotajeType .

:CommonCrime a skos:Concept ;
    skos:prefLabel "Common Crime"@en , "Delito Común"@es ;
    skos:definition "Criminal charges applicable to general conduct but frequently applied to political actions"@en ;
    skos:definition "Cargos criminales aplicables a conducta general pero frecuentemente aplicados a acciones políticas"@es ;
    skos:inScheme :CubanPenalCode ;
    skos:narrower :AtentadoType , :DesacatoType , :DesordenesPublicosType , :ResistenciaType .

# ============================================================================
# CHARGE TYPES (Full SKOS Vocabulary)
# ============================================================================

:SedicionType a :ChargeType ;
    skos:prefLabel "Sedición"@es , "Sedition"@en ;
    skos:altLabel "Sedición contra el Estado"@es ;
    skos:altLabel "Incitación a la sedición"@es ;
    skos:altLabel "Sedition against the State"@en ;
    skos:altLabel "Incitement to sedition"@en ;
    skos:definition "Incitar, promover o ejecutar actos destinados a subvertir el orden constitucional o derrocar al gobierno por medios violentos o ilegales"@es ;
    skos:definition "Inciting, promoting, or executing acts intended to subvert the constitutional order or overthrow the government by violent or illegal means"@en ;
    skos:scopeNote "Código Penal Cubano Artículo 100. Sanción de 7-15 años de prisión o pena de muerte en casos agravados"@es ;
    skos:scopeNote "Cuban Penal Code Article 100. Penalty ranges from 7-15 years imprisonment or death penalty in aggravated cases"@en ;
    skos:editorialNote "In practice, applied broadly to peaceful political expression, protest participation, and dissent, in violation of ICCPR Article 19"@en ;
    skos:broader :PoliticalCrime ;
    skos:related :DesordenesPublicosType , :AtentadoType ;
    skos:inScheme :CubanPenalCode .

:DesacatoType a :ChargeType ;
    skos:prefLabel "Desacato"@es , "Contempt"@en ;
    skos:altLabel "Desacato a la autoridad"@es ;
    skos:altLabel "Falta de respeto"@es ;
    skos:altLabel "Contempt of authority"@en ;
    skos:altLabel "Disrespect"@en ;
    skos:definition "Mostrar falta de respeto, ofender o amenazar a funcionarios públicos en ejercicio de sus funciones"@es ;
    skos:definition "Showing disrespect, offending, or threatening public officials in the exercise of their duties"@en ;
    skos:scopeNote "Código Penal Cubano Artículo 144. Sanción de 3 meses a 1 año de prisión o multa"@es ;
    skos:scopeNote "Cuban Penal Code Article 144. Penalty ranges from 3 months to 1 year imprisonment or fine"@en ;
    skos:editorialNote "Used to criminalize criticism of government officials or policies"@en ;
    skos:broader :CommonCrime ;
    skos:inScheme :CubanPenalCode .

:DesordenesPublicosType a :ChargeType ;
    skos:prefLabel "Desórdenes Públicos"@es , "Public Disorder"@en ;
    skos:altLabel "Alteración del orden público"@es ;
    skos:altLabel "Disturbios"@es ;
    skos:altLabel "Public disturbance"@en ;
    skos:altLabel "Riots"@en ;
    skos:definition "Participar en reuniones, manifestaciones o actos que alteren el orden público"@es ;
    skos:definition "Participating in gatherings, demonstrations, or acts that disturb public order"@en ;
    skos:scopeNote "Código Penal Cubano Artículo 200. Sanción de 3 meses a 1 año de prisión o multa"@es ;
    skos:scopeNote "Cuban Penal Code Article 200. Penalty ranges from 3 months to 1 year imprisonment or fine"@en ;
    skos:editorialNote "Applied to peaceful protests and unauthorized assemblies in violation of freedom of assembly"@en ;
    skos:broader :CommonCrime ;
    skos:related :SedicionType , :AtentadoType ;
    skos:inScheme :CubanPenalCode .

:AtentadoType a :ChargeType ;
    skos:prefLabel "Atentado"@es , "Assault"@en ;
    skos:altLabel "Atentado contra la autoridad"@es ;
    skos:altLabel "Agresión"@es ;
    skos:altLabel "Assault on authority"@en ;
    skos:altLabel "Attack"@en ;
    skos:definition "Acometer, agredir o usar violencia contra personas, especialmente autoridades"@es ;
    skos:definition "Attacking, assaulting, or using violence against persons, especially authorities"@en ;
    skos:scopeNote "Código Penal Cubano Artículo 271. Sanción varía según gravedad"@es ;
    skos:scopeNote "Cuban Penal Code Article 271. Penalty varies by severity"@en ;
    skos:editorialNote "Often charged alongside public disorder to increase sentence severity"@en ;
    skos:broader :CommonCrime ;
    skos:related :DesordenesPublicosType ;
    skos:inScheme :CubanPenalCode .

:SabotajeType a :ChargeType ;
    skos:prefLabel "Sabotaje"@es , "Sabotage"@en ;
    skos:altLabel "Sabotaje económico"@es ;
    skos:altLabel "Daños a la economía"@es ;
    skos:altLabel "Economic sabotage"@en ;
    skos:altLabel "Damage to economy"@en ;
    skos:definition "Destruir, dañar o inutilizar bienes o recursos de importancia económica o social"@es ;
    skos:definition "Destroying, damaging, or disabling goods or resources of economic or social importance"@en ;
    skos:scopeNote "Código Penal Cubano Artículo 91. Sanción de 7-15 años de prisión o pena de muerte en casos agravados"@es ;
    skos:scopeNote "Cuban Penal Code Article 91. Penalty ranges from 7-15 years imprisonment or death penalty in aggravated cases"@en ;
    skos:editorialNote "Applied to property damage during protests, regardless of economic significance"@en ;
    skos:broader :PoliticalCrime ;
    skos:inScheme :CubanPenalCode .

:ResistenciaType a :ChargeType ;
    skos:prefLabel "Resistencia"@es , "Resistance"@en ;
    skos:altLabel "Resistencia a la autoridad"@es ;
    skos:altLabel "Desobediencia"@es ;
    skos:altLabel "Resisting authority"@en ;
    skos:altLabel "Disobedience"@en ;
    skos:definition "Resistir o desobedecer órdenes de autoridades o impedir su ejecución"@es ;
    skos:definition "Resisting or disobeying orders from authorities or preventing their execution"@en ;
    skos:scopeNote "Código Penal Cubano Artículo 160. Sanción de 3 meses a 1 año"@es ;
    skos:scopeNote "Cuban Penal Code Article 160. Penalty ranges from 3 months to 1 year"@en ;
    skos:editorialNote "Routinely charged alongside other offenses to compound sentences"@en ;
    skos:broader :CommonCrime ;
    skos:inScheme :CubanPenalCode .

:PropagandaEnemigaType a :ChargeType ;
    skos:prefLabel "Propaganda Enemiga"@es , "Enemy Propaganda"@en ;
    skos:altLabel "Propaganda subversiva"@es ;
    skos:altLabel "Difusión enemiga"@es ;
    skos:altLabel "Subversive propaganda"@en ;
    skos:altLabel "Enemy dissemination"@en ;
    skos:definition "Difundir propaganda falsa contra el Estado cubano o propagar noticias falsas o predicciones alarmistas"@es ;
    skos:definition "Disseminating false propaganda against the Cuban State or spreading false news or alarmist predictions"@en ;
    skos:scopeNote "Código Penal Cubano Artículo 103. Sanción de 1-8 años de prisión"@es ;
    skos:scopeNote "Cuban Penal Code Article 103. Penalty ranges from 1-8 years imprisonment"@en ;
    skos:editorialNote "Applied to independent journalism, social media posts critical of government"@en ;
    skos:broader :PoliticalCrime ;
    skos:inScheme :CubanPenalCode .

:PropagandaContraOrdenType a :ChargeType ;
    skos:prefLabel "Propaganda Contra el Orden Constitucional"@es , "Propaganda Against Constitutional Order"@en ;
    skos:altLabel "Propaganda contra el orden socialista"@es ;
    skos:altLabel "Propaganda against socialist order"@en ;
    skos:definition "Incitar contra el orden socialista mediante propaganda oral, escrita o de cualquier forma"@es ;
    skos:definition "Inciting against the socialist order through oral, written, or any form of propaganda"@en ;
    skos:scopeNote "Código Penal Cubano Artículo 115. Sanción de 1-8 años de prisión"@es ;
    skos:scopeNote "Cuban Penal Code Article 115. Penalty ranges from 1-8 years imprisonment"@en ;
    skos:editorialNote "Criminalizes political speech protected under ICCPR Article 19"@en ;
    skos:broader :PoliticalCrime ;
    skos:related :PropagandaEnemigaType ;
    skos:inScheme :CubanPenalCode .
