@prefix : <http://prisoners.defenders.org/ontology#> .
@prefix bfo: <http://purl.obolibrary.org/obo/> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix data: <http://prisoners.defenders.org/data/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dpv: <https://w3id.org/dpv#> .
@prefix dpv-pd: <https://w3id.org/dpv/dpv-pd#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix policy: <http://prisoners.defenders.org/policy#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://prisoners.defenders.org/ontology> a owl:Ontology ;
    dcterms:created "2026-05-16"^^xsd:date ;
    dcterms:creator <http://prisoners.defenders.org/agent/project> ;
    dcterms:description "Schema for modeling political detention, judicial persecution, and coercive labor in Cuba, with SKOS separation of official terminology from analytical assessment."@en ;
    dcterms:modified "2026-08-22"^^xsd:date ;
    dcterms:source <https://lista.prisonersdefenders.org/> ;
    dcterms:title "Cuban Political Prisoners Ontology (T-Box)"@en,
        "Ontología de Presos Políticos Cubanos (T-Box)"@es ;
    rdfs:comment "T-Box only. Import this from your A-Box file via owl:imports."@en ;
    owl:imports bfo:bfo.owl,
        <http://www.w3.org/ns/prov-o> ;
    owl:versionIRI <http://prisoners.defenders.org/ontology/3.0-tbox> ;
    owl:versionInfo "3.0 (T-Box): corrected BFO alignment, reified temporal status, TortureFacility restructured as reported-practice pattern, disjointness extended." .

:ForcedLabor a owl:Class ;
    rdfs:label "Forced Labor"@en ;
    rdfs:subClassOf :ReportedPractice ;
    skos:scopeNote "Definition per ILO Convention 29 Art. 2."@en .

:JudicialProceeding a owl:Class ;
    rdfs:label "Judicial Proceeding"@en,
        "Proceso Judicial"@es ;
    rdfs:subClassOf bfo:BFO_0000015 .

:LaborCamp a owl:Class ;
    rdfs:label "Labor Camp"@en,
        "Campo de Trabajo"@es ;
    rdfs:subClassOf :DetentionFacility ;
    skos:editorialNote "Neutral facility class. Forced-labor conditions are asserted per instance via :hasReportedPractice :ForcedLabor."@en .

:MedicalNeglect a owl:Class ;
    rdfs:label "Medical Neglect"@en ;
    rdfs:subClassOf :ReportedPractice .

:PhysicalAbuse a owl:Class ;
    rdfs:label "Physical Abuse"@en ;
    rdfs:subClassOf :ReportedPractice .

:PoliticalPrisonerRole a owl:Class ;
    rdfs:label "Political Prisoner Role"@en ;
    rdfs:subClassOf :PenalStatus .

:PretrialDetentionCenter a owl:Class ;
    rdfs:label "Pretrial Detention Center"@en,
        "Centro de Detención Preventiva"@es ;
    rdfs:subClassOf :DetentionFacility .

:Prison a owl:Class ;
    rdfs:label "Prison"@en,
        "Prisión"@es ;
    rdfs:subClassOf :DetentionFacility .

:ProlongedIsolation a owl:Class ;
    rdfs:label "Prolonged Isolation"@en ;
    rdfs:subClassOf :ReportedPractice .

:SleepDeprivation a owl:Class ;
    rdfs:label "Sleep Deprivation"@en ;
    rdfs:subClassOf :ReportedPractice .

:ThreatsAgainstFamily a owl:Class ;
    rdfs:label "Threats Against Family"@en ;
    rdfs:subClassOf :ReportedPractice .

:administeredBy a owl:ObjectProperty ;
    rdfs:label "administered by"@en ;
    rdfs:domain :DetentionFacility ;
    rdfs:range foaf:Organization .

:ageAtArrest a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain :Person ;
    rdfs:range xsd:nonNegativeInteger .

:arrestDate a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain :Arrest ;
    rdfs:range xsd:date .

:arrestOf a owl:ObjectProperty ;
    rdfs:label "arrest of"@en ;
    rdfs:domain :Arrest ;
    rdfs:range :Person ;
    owl:inverseOf :arrested .

:chargedWith a owl:ObjectProperty ;
    rdfs:label "charged with"@en ;
    rdfs:domain :Person ;
    rdfs:range :Charge ;
    owl:inverseOf :filedAgainst .

:containsMunicipality a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "contains municipality"@en ;
    rdfs:domain :Province ;
    rdfs:range :Municipality .

:currentAge a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain :Person ;
    rdfs:range xsd:nonNegativeInteger .

:detainedAtDuringPeriod a owl:ObjectProperty ;
    rdfs:label "detained at during period"@en ;
    rdfs:domain :StatusPeriod ;
    rdfs:range :DetentionFacility .

:facilityName a owl:DatatypeProperty ;
    rdfs:comment "Common name; not necessarily official designation."@en ;
    rdfs:domain :DetentionFacility ;
    rdfs:range xsd:string .

:fullName a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain :Person ;
    rdfs:range xsd:string .

:hasChargeType a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has charge type"@en ;
    rdfs:domain :Charge ;
    rdfs:range :ChargeType .

:hasReportedPractice a owl:ObjectProperty ;
    rdfs:label "has reported practice"@en ;
    rdfs:comment "Analytical assertion. Requires at least one prov:wasDerivedFrom evidence source on the ReportedPractice instance (enforced by SHACL)."@en ;
    rdfs:domain :DetentionFacility ;
    rdfs:range :ReportedPractice .

:locatedInMunicipality a owl:ObjectProperty ;
    rdfs:label "located in municipality"@en ;
    rdfs:domain :DetentionFacility ;
    rdfs:range :Municipality .

:locatedInProvince a owl:ObjectProperty ;
    rdfs:label "located in province"@en ;
    rdfs:domain :DetentionFacility ;
    rdfs:range :Province .

:municipalityName a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain :Municipality ;
    rdfs:range xsd:string .

:occurredInProvince a owl:ObjectProperty ;
    rdfs:label "occurred in province"@en ;
    rdfs:domain :Arrest ;
    rdfs:range :Province .

:officialDesignation a owl:DatatypeProperty ;
    rdfs:domain :DetentionFacility ;
    rdfs:range xsd:string .

:partOfWave a owl:ObjectProperty ;
    rdfs:label "part of wave"@en ;
    rdfs:comment "Populated by SPARQL CONSTRUCT rule, not manually asserted."@en ;
    rdfs:domain :Arrest ;
    rdfs:range :ArrestWave .

:penalStatusInPeriod a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "penal status in period"@en ;
    rdfs:domain :StatusPeriod ;
    rdfs:range :PenalStatus .

:periodInterval a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "period interval"@en ;
    rdfs:domain :StatusPeriod ;
    rdfs:range time:Interval .

:provinceName a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain :Province ;
    rdfs:range xsd:string .

:residesInProvince a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "resides in province"@en ;
    rdfs:comment "Person's home province, distinct from detention location."@en ;
    rdfs:domain :Person ;
    rdfs:range :Province .

:scrapedAt a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf ( :Person :Arrest :Charge :Sentence ) ] ;
    rdfs:range xsd:dateTime .

:sentenceLengthYears a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain :Sentence ;
    rdfs:range xsd:decimal .

:sentenced a owl:ObjectProperty ;
    rdfs:label "sentenced"@en ;
    rdfs:domain :Person ;
    rdfs:range :Sentence .

:sourceURL a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf ( :Person :Arrest :Charge :Sentence :ReportedPractice ) ] ;
    rdfs:range xsd:anyURI .

:statusOf a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "status of"@en ;
    rdfs:domain :StatusPeriod ;
    rdfs:range :Person ;
    owl:inverseOf :hasStatusPeriod .

policy:DataProcessing a dpv:PersonalDataHandling ;
    dpv:hasDataSubject dpv:DataSubject ;
    dpv:hasLegalBasis policy:LegitimateInterestPublicInterest ;
    dpv:hasPersonalData dpv-pd:Age,
        dpv-pd:CriminalConviction,
        dpv-pd:Location,
        dpv-pd:Name,
        dpv-pd:PoliticalOpinion ;
    dpv:hasProcessing dpv:Analyse,
        dpv:Collect,
        dpv:Disclose,
        dpv:MakeAvailable,
        dpv:Store ;
    dpv:hasPurpose policy:PublicInterestHumanRights ;
    dpv:hasRisk policy:FamilyEndangermentRisk,
        policy:RetaliationRisk .

policy:LowRisk a policy:RiskLevel ;
    rdfs:comment "Departed Cuba; already public figure; deceased."@en ;
    skos:prefLabel "Low Risk"@en .

policy:MediumRisk a policy:RiskLevel ;
    rdfs:comment "Released but remaining in Cuba, subject to continued state surveillance."@en ;
    skos:prefLabel "Medium Risk"@en .

policy:SpecialCategoryFlag a dpv:SpecialCategoryPersonalData ;
    rdfs:comment "Entire dataset qualifies as special-category personal data per GDPR Art. 9 and analogous frameworks."@en .

policy:UsePolicy a odrl:Policy,
        odrl:Set ;
    dcterms:description "Machine-readable use policy for the Cuban Political Prisoners Dataset."@en ;
    odrl:permission [ odrl:action odrl:derive,
                odrl:distribute,
                odrl:reproduce ;
            odrl:duty [ odrl:action cc:Attribution ;
                    odrl:target policy:CubanPoliticalPrisonersDataset ] ;
            odrl:target policy:CubanPoliticalPrisonersDataset ] ;
    odrl:prohibition [ rdfs:comment "Prohibits combining with other datasets to derive additional PII about listed individuals (e.g., family members, home addresses, employers)."@en ;
            odrl:action odrl:aggregate ;
            odrl:target policy:CubanPoliticalPrisonersDataset ],
        [ odrl:action odrl:commercialize,
                odrl:sell ;
            odrl:target policy:CubanPoliticalPrisonersDataset ],
        [ rdfs:comment "Prohibits use as training data for generative or classification models targeting individuals."@en ;
            odrl:action policy:trainModel ;
            odrl:target policy:CubanPoliticalPrisonersDataset ] .

policy:VerificationActivity a owl:Class ;
    rdfs:label "Manual Verification Activity"@en ;
    rdfs:comment "A human verification pass against the primary source."@en ;
    rdfs:subClassOf prov:Activity .

policy:hasRiskLevel a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has risk level"@en ;
    rdfs:domain :Person ;
    rdfs:range policy:RiskLevel .

policy:verificationDate a owl:DatatypeProperty ;
    rdfs:domain :Person ;
    rdfs:range xsd:date .

policy:verifiedBy a owl:ObjectProperty ;
    rdfs:label "verified by"@en ;
    rdfs:domain :Person ;
    rdfs:range prov:Agent .

